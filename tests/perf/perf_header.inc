// ===========================================================================
// PERF BUILD — generated by tests/perf/make_perf_build.py. Measurement only;
// never submit this file. Each instrumented entry point records its duration
// (QueryPerformanceCounter). Every 60 s a summary of that interval is logged
// ("PERF ...", printed outside timed scopes and locks), and a since-load
// summary is logged at unload. Inclusive
// times: a nested instrumented call is also counted in its caller. "busy" =
// time in outermost instrumented scopes per thread kind.
// ===========================================================================
namespace perf {
enum class Kind { UI, Worker, Inner };  // Inner: either thread, nested
struct SlotDef {
    const wchar_t* name;
    Kind kind;
};
// PERF_SLOTS
constexpr int kBuckets = 24;  // bucket b: duration < 2^b us (b = 0: < 1 us)
struct Stats {
    unsigned long long count = 0, totalNs = 0, maxNs = 0;
    unsigned int hist[kBuckets] = {};
    void Add(unsigned long long ns) {
        ++count;
        totalNs += ns;
        if (ns > maxNs) maxNs = ns;
        unsigned long long us = ns / 1000;
        int b = 0;
        while (b < kBuckets - 1 && (1ULL << b) <= us) ++b;
        ++hist[b];
    }
    void Merge(const Stats& o) {
        count += o.count;
        totalNs += o.totalNs;
        if (o.maxNs > maxNs) maxNs = o.maxNs;
        for (int b = 0; b < kBuckets; ++b) hist[b] += o.hist[b];
    }
    // Upper bound (us) of the bucket holding the given percentile.
    unsigned long long PercentileUs(int pct) const {
        if (!count) return 0;
        unsigned long long need = (count * pct + 99) / 100, seen = 0;
        for (int b = 0; b < kBuckets; ++b) {
            seen += hist[b];
            if (seen >= need) return 1ULL << b;
        }
        return 1ULL << (kBuckets - 1);
    }
};
struct State {
    std::mutex m;
    Stats interval[kSlotCount], total[kSlotCount];
    unsigned long long busyNs[2] = {}, busyTotalNs[2] = {};
    long long intervalStart = 0, loadStart = 0;
    bool started = false;
};
inline State& S() {
    [[clang::no_destroy]] static State s;
    return s;
}
inline long long Now() {
    LARGE_INTEGER v;
    QueryPerformanceCounter(&v);
    return v.QuadPart;
}
inline unsigned long long ToNs(long long ticks) {
    static const long long freq = [] {
        LARGE_INTEGER f;
        QueryPerformanceFrequency(&f);
        return f.QuadPart;
    }();
    // Split to avoid overflow on long spans (since-load).
    const unsigned long long t = static_cast<unsigned long long>(ticks);
    const unsigned long long f = static_cast<unsigned long long>(freq);
    return t / f * 1000000000ULL + t % f * 1000000000ULL / f;
}
// Microseconds with one decimal, as two integers (no %f in logs).
#define PERF_US10(ns) (ns) / 1000, ((ns) / 100) % 10
inline void LogStats(const wchar_t* scope, int slot, const Stats& st) {
    const unsigned long long avg = st.count ? st.totalNs / st.count : 0;
    Wh_Log(L"PERF %s %s: n=%llu total=%llu.%llums avg=%llu.%lluus "
           L"p50<%lluus p95<%lluus p99<%lluus max=%llu.%lluus",
           scope, kSlots[slot].name, st.count, st.totalNs / 1000000,
           (st.totalNs / 100000) % 10, PERF_US10(avg), st.PercentileUs(50),
           st.PercentileUs(95), st.PercentileUs(99), PERF_US10(st.maxNs));
}
inline void ReportLocked(State& s, bool sinceLoad, long long now) {
    const wchar_t* scope = sinceLoad ? L"since-load" : L"interval";
    const unsigned long long spanNs =
        ToNs(now - (sinceLoad ? s.loadStart : s.intervalStart));
    const unsigned long long* busy = sinceLoad ? s.busyTotalNs : s.busyNs;
    // Busy share in 1/1000 of the span (no %f).
    const unsigned long long uiPm = spanNs ? busy[0] * 100000 / spanNs : 0;
    Wh_Log(L"PERF %s: span=%llus uiBusy=%llu.%llums (%llu.%03llu%%) "
           L"workerBusy=%llu.%llums",
           scope, spanNs / 1000000000ULL, busy[0] / 1000000,
           (busy[0] / 100000) % 10, uiPm / 1000, uiPm % 1000,
           busy[1] / 1000000, (busy[1] / 100000) % 10);
    for (int i = 0; i < kSlotCount; ++i) {
        const Stats& st = sinceLoad ? s.total[i] : s.interval[i];
        if (st.count) LogStats(scope, i, st);
    }
}
inline void Report(bool sinceLoad) {
    State& s = S();
    std::lock_guard<std::mutex> lock(s.m);
    ReportLocked(s, sinceLoad, Now());
}
inline thread_local int t_depth = 0;
inline thread_local int t_lockDepth = 0;  // TimedLocks held by this thread
inline thread_local bool t_isWorker = false;  // set by any Worker scope
// The interval report is printed only by a thread outside every timed scope
// and lock: printing ~35 lines to a listening debugger takes 13-19 ms, and
// before 2026-11-17 that time showed up as lock holds / scope maxima of
// whatever the reporting thread was inside (0.11.41 runs).
inline void ReportIfDue() {
    if (t_depth != 0 || t_lockDepth != 0) {
        return;
    }
    State& s = S();
    std::lock_guard<std::mutex> lock(s.m);
    const long long now = Now();
    if (!s.started || ToNs(now - s.intervalStart) < 60000000000ULL) {
        return;
    }
    ReportLocked(s, false, now);
    for (auto& st : s.interval) st = Stats{};
    s.busyNs[0] = s.busyNs[1] = 0;
    s.intervalStart = now;
}
inline void Record(int slot, long long start, long long end, bool outer) {
    const unsigned long long ns = ToNs(end - start);
    State& s = S();
    std::lock_guard<std::mutex> lock(s.m);
    if (!s.started) {
        s.started = true;
        s.loadStart = s.intervalStart = start;
    }
    s.interval[slot].Add(ns);
    s.total[slot].Add(ns);
    if (outer) {
        const Kind kind = kSlots[slot].kind;
        const int k = kind == Kind::UI ? 0
                      : kind == Kind::Worker ? 1
                                             : (t_isWorker ? 1 : 0);
        s.busyNs[k] += ns;
        s.busyTotalNs[k] += ns;
    }
}
struct Scope {
    int slot;
    long long start;
    explicit Scope(int sl) : slot(sl), start(Now()) {
        ++t_depth;
        if (kSlots[sl].kind == Kind::Worker) t_isWorker = true;
    }
    ~Scope() {
        const long long end = Now();
        const bool outer = --t_depth == 0;
        Record(slot, start, end, outer);
        ReportIfDue();
    }
};
// Replaces std::lock_guard on g_stateMutex / g_buttonPathMutex: wait time
// to acquire and hold time, split by thread (worker = a thread that ran a
// Worker scope). Not counted as busy time (already inside the callers'
// scopes).
struct TimedLock {
    std::mutex& m;
    long long acquired;
    bool worker;
    bool buttonPath;
    explicit TimedLock(std::mutex& mu, bool isButtonPath = false)
        : m(mu), worker(t_isWorker), buttonPath(isButtonPath) {
        const long long start = Now();
        m.lock();
        ++t_lockDepth;
        acquired = Now();
        Record(buttonPath ? (worker ? WorkerButtonLockWait : UIButtonLockWait)
                          : (worker ? WorkerStateLockWait : UIStateLockWait),
               start, acquired, false);
    }
    ~TimedLock() {
        const long long end = Now();
        --t_lockDepth;
        m.unlock();
        Record(buttonPath ? (worker ? WorkerButtonLockHold : UIButtonLockHold)
                          : (worker ? WorkerStateLockHold : UIStateLockHold),
               acquired, end, false);
    }
    TimedLock(const TimedLock&) = delete;
    TimedLock& operator=(const TimedLock&) = delete;
};
}  // namespace perf
#define PERF_SCOPE(slot) perf::Scope perfScope_##slot(perf::slot)
// ======================= end of PERF BUILD header ==========================
